# ─── Supabase ────────────────────────────────────────────────
# Settings → API в панели Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Секретный ключ (только для сервера! никогда не отдаём в браузер)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Telegram ───────────────────────────────────────────────
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# chat_id мастера (бот пришлёт его в ответ на /start).
# Можно несколько через запятую: 111111,222222
TELEGRAM_MASTER_CHAT_ID=
# Любая длинная случайная строка — защищает вебхук от чужих запросов
TELEGRAM_WEBHOOK_SECRET=change-me-long-random-string

# ─── Приложение ─────────────────────────────────────────────
# Публичный адрес сайта (нужен для ссылок в Telegram и установки вебхука)
NEXT_PUBLIC_APP_URL=https://uya-home.vercel.app
# Секрет для Vercel Cron (досылка неотправленных уведомлений)
CRON_SECRET=change-me-another-random-string
